    match /fixtures/{fixtureId} {
      allow get: if isSignedIn() && isValidId(fixtureId) && (existing().published == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.published == true || resource.data.authorId == request.auth.uid || isVerifiedOwner());
      allow create: if isAdmin() &&
                       isValidId(fixtureId) &&
                       isValidFixture(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().keys().hasAll(['authorId', 'homeTeam', 'awayTeam', 'competition', 'homeScore', 'awayScore', 'status', 'minuteLabel', 'kickoffEpochMs', 'sourceLabel', 'streamScheduled', 'streamStatus', 'published', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['authorId', 'homeTeam', 'awayTeam', 'competition', 'homeScore', 'awayScore', 'status', 'minuteLabel', 'kickoffEpochMs', 'venue', 'sourceLabel', 'streamScheduled', 'streamStatus', 'streamUrl', 'eventsSummary', 'published', 'createdAt', 'updatedAt']);
      allow update: if isAdmin() &&
                       isValidId(fixtureId) &&
                       isValidFixture(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(fixtureId);
    }

    match /groups/{groupId} {
      allow get: if isSignedIn() && isValidId(groupId) && (existing().publicRoom == true || request.auth.uid in existing().memberUids || isAdmin());
      allow list: if isSignedIn() && (resource.data.publicRoom == true || request.auth.uid in resource.data.memberUids || isVerifiedOwner());
      allow create: if isSignedIn() &&
                       isValidId(groupId) &&
                       isValidGroup(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll(['title', 'directMessage', 'publicRoom', 'createdBy', 'memberUids', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'description', 'directMessage', 'publicRoom', 'createdBy', 'memberUids', 'lastMessage', 'lastSenderName', 'createdAt', 'updatedAt']);
      allow update: if isSignedIn() &&
                       isValidId(groupId) &&
                       isValidGroup(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid in existing().memberUids &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderName', 'memberUids', 'updatedAt'])) ||
                         (existing().publicRoom == true &&
                          request.auth.uid in incoming().memberUids &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']))
                       );
      allow delete: if isAdmin() || (isSignedIn() && isValidId(groupId) && existing().createdBy == request.auth.uid);

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId) && (existing().publicRoom == true || request.auth.uid in existing().memberUids || isAdmin());
        allow list: if isSignedIn() && (resource.data.publicRoom == true || request.auth.uid in resource.data.memberUids || isVerifiedOwner());
        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         isValidGroupMessage(incoming()) &&
                         incoming().senderId == request.auth.uid &&
                         exists(/databases/$(database)/documents/groups/$(groupId)) &&
                         (get(/databases/$(database)/documents/groups/$(groupId)).data.publicRoom == true ||
                          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids) &&
                         incoming().keys().hasAll(['senderId', 'senderName', 'text', 'publicRoom', 'memberUids', 'createdAt']) &&
                         incoming().keys().hasOnly(['senderId', 'senderName', 'text', 'imageUrl', 'publicRoom', 'memberUids', 'createdAt']);
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(messageId) && (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isVerifiedOwner());
      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       isValidReport(incoming()) &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'OPEN' &&
                       incoming().keys().hasAll(['reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt']);
      allow update: if isAdmin() &&
                       isValidId(reportId) &&
                       isValidReport(incoming()) &&
                       incoming().reporterId == existing().reporterId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin() && isValidId(reportId);
    }

    match /admin_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isVerifiedOwner() || (isSignedIn() && resource.data.actorId == request.auth.uid);
      allow create: if isAdmin() &&
                       isValidId(logId) &&
                       isValidAdminLog(incoming()) &&
                       incoming().actorId == request.auth.uid &&
                       incoming().keys().hasAll(['actorId', 'actorEmail', 'action', 'targetType', 'targetId', 'details', 'createdAt']) &&
                       incoming().keys().hasOnly(['actorId', 'actorEmail', 'action', 'targetType', 'targetId', 'details', 'createdAt']);
      allow update, delete: if false;
    }

    match /app_settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId);
      allow list: if isVerifiedOwner();
      allow create, update: if isAdmin() &&
                               isValidId(settingId) &&
                               isValidAppSettings(incoming()) &&
                               incoming().keys().hasAll(['vipWeeklyTzs', 'vipMonthlyTzs', 'merchantNumber', 'merchantName', 'categories', 'updatedAt']) &&
                               incoming().keys().hasOnly(['vipDailyTzs', 'vipWeeklyTzs', 'vipMonthlyTzs', 'vipQuarterlyTzs', 'vipAnnualTzs', 'merchantNumber', 'merchantName', 'categories', 'liveUpdateBanner', 'liveSyncIntervalSec', 'configVersion', 'updatedAt']);
      allow delete: if false;
    }

    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(statusId) &&
                       isValidStatus(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().keys().hasAll(['authorId', 'authorName', 'text', 'themeColor', 'expiresAtEpochMs', 'createdAt']) &&
                       incoming().keys().hasOnly(['authorId', 'authorName', 'authorPhotoUrl', 'text', 'themeColor', 'expiresAtEpochMs', 'createdAt']);
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && isValidId(statusId) && existing().authorId == request.auth.uid);
    }
  }
}
