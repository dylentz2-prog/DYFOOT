# GEMINI_API_KEY: Unused in DYFOOT (preserve template note).
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# FOOTBALL_DATA_API_KEY: Optional API token for live football scores & league standings from football-data.org (v4).
# Configure via the Secrets panel in AI Studio.
FOOTBALL_DATA_API_KEY=YOUR_FOOTBALL_DATA_API_KEY

# MOBILE_MONEY_MERCHANT_KEY: Optional merchant gateway token for automated Tanzania mobile money STK push & webhook verification.
# Receiving number configured for DYFOOT: 0706499813
MOBILE_MONEY_MERCHANT_KEY=YOUR_MOBILE_MONEY_MERCHANT_KEY

# DATASPORTS_API_KEY: API token for DataSportsAPI live football scores & telemetry (https://api.datasportsapi.com).
# Configure via the Secrets panel in AI Studio.
DATASPORTS_API_KEY=YOUR_DATASPORTS_API_KEY

# LIVE_FOOTBALL_API_KEY: API key for Live Football API live matches, details & standings (https://live-football-api.com).
# Configure via the Secrets panel in AI Studio.
LIVE_FOOTBALL_API_KEY=YOUR_LIVE_FOOTBALL_API_KEY
